# Copy this file to .env and fill in ALL values before starting the server.

# ── Gemini AI ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ── JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ──
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_64_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_min_64_chars

# ── CORS (set to your production frontend URL in production) ──
CLIENT_ORIGIN=http://localhost:5173

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
